# Set a unique password of at least 12 characters before starting the API.
NEUROMAP_PASSWORD=replace-with-a-unique-long-password
NEUROMAP_DATA_DIR=./data
NEUROMAP_DATABASE_URL=sqlite:///./data/neuromap.db
NEUROMAP_ORIGINS=["http://localhost:5173","http://localhost:4173"]
# Optional frontend build override. Empty uses same-origin /api via Vite/nginx.
VITE_API_URL=
